{
  "github_org": "randy-girard",
  "plugins": [
    {
      "name": "redis",
      "kind": "resource-provider",
      "repo": "flynn-plugin-redis",
      "description": "Redis. Provision with flynn addons:create redis.",
      "addon": {
        "type": "redis",
        "description": "Isolated Redis instance",
        "verbs": [
          "create",
          "destroy",
          "attach",
          "detach",
          "expose"
        ],
        "backend": "resource",
        "create": "[--follow <resource>] [--runtime <name>] [--replication <mode>] [--auto-failover] [--cpu <milli>] [--memory <bytes>] [--disk <bytes>]",
        "env": {
          "prefix": "FLYNN_REDIS_",
          "conventional": "REDIS_URL"
        },
        "runtimes": {
          "source": "catalog",
          "engine": "redis",
          "default": "small",
          "custom_sizing": true
        },
        "expose": {
          "protocol": "tcp",
          "tls_modes": [
            "off",
            "passthrough",
            "terminate"
          ],
          "default_tls": "passthrough",
          "hostname": "SERVICE.CLUSTERDOMAIN"
        },
        "instance_port": true,
        "wait": "redis:wait",
        "requires": [
          {
            "flag": "--auto-failover",
            "needs": "--follow",
            "message": "--auto-failover requires --follow"
          }
        ],
        "destroy": {
          "follower_env": [
            "FLYNN_REDIS_LEADER",
            "REDIS_LEADER"
          ]
        },
        "pass_app": true
      }
    },
    {
      "name": "postgres",
      "kind": "resource-provider",
      "repo": "flynn-plugin-postgres",
      "description": "Tenant Postgres. One isolated instance per resource. Provision with flynn addons:create postgres. Not the platform appliance.",
      "addon": {
        "type": "postgres",
        "description": "Isolated Postgres instance",
        "verbs": [
          "create",
          "destroy",
          "attach",
          "detach",
          "expose"
        ],
        "backend": "resource",
        "create": "[--follow <resource>] [--runtime <name>] [--replication <mode>] [--auto-failover] [--cpu <milli>] [--memory <bytes>] [--disk <bytes>]",
        "env": {
          "prefix": "FLYNN_POSTGRESQL_",
          "conventional": "DATABASE_URL"
        },
        "runtimes": {
          "source": "catalog",
          "engine": "postgres",
          "default": "small",
          "custom_sizing": true
        },
        "expose": {
          "protocol": "tcp",
          "tls_modes": [
            "off",
            "passthrough",
            "terminate"
          ],
          "default_tls": "passthrough",
          "hostname": "SERVICE.CLUSTERDOMAIN"
        },
        "instance_port": true,
        "wait": "pg:wait",
        "requires": [
          {
            "flag": "--auto-failover",
            "needs": "--follow",
            "message": "--auto-failover requires --follow"
          }
        ],
        "destroy": {
          "follower_env": [
            "FLYNN_POSTGRES_LEADER",
            "POSTGRES_LEADER"
          ]
        },
        "pass_app": true
      }
    },
    {
      "name": "mysql",
      "aliases": [
        "mariadb"
      ],
      "kind": "resource-provider",
      "repo": "flynn-plugin-mysql",
      "description": "MySQL-compatible databases (MariaDB 10.11 engine). Install as mysql or mariadb; provision with flynn addons:create mysql.",
      "addon": {
        "type": "mysql",
        "description": "Isolated MariaDB / MySQL instance",
        "verbs": [
          "create",
          "destroy",
          "attach",
          "detach",
          "expose"
        ],
        "backend": "resource",
        "create": "[--follow <resource>] [--runtime <name>] [--replication <mode>] [--auto-failover] [--cpu <milli>] [--memory <bytes>] [--disk <bytes>]",
        "env": {
          "prefix": "FLYNN_MYSQL_",
          "conventional": "DATABASE_URL"
        },
        "runtimes": {
          "source": "catalog",
          "engine": "mysql",
          "default": "small",
          "custom_sizing": true
        },
        "expose": {
          "protocol": "tcp",
          "tls_modes": [
            "off",
            "passthrough",
            "terminate"
          ],
          "default_tls": "passthrough",
          "hostname": "SERVICE.CLUSTERDOMAIN"
        },
        "instance_port": true,
        "wait": "mysql:wait",
        "requires": [
          {
            "flag": "--auto-failover",
            "needs": "--follow",
            "message": "--auto-failover requires --follow"
          }
        ],
        "destroy": {
          "follower_env": [
            "FLYNN_MYSQL_LEADER",
            "MYSQL_LEADER"
          ]
        },
        "aliases": [
          "mariadb"
        ],
        "pass_app": true
      }
    },
    {
      "name": "mongodb",
      "kind": "resource-provider",
      "repo": "flynn-plugin-mongodb",
      "description": "MongoDB 7.0 replica set. Provision with flynn addons:create mongodb.",
      "addon": {
        "type": "mongodb",
        "description": "Isolated MongoDB replica set",
        "verbs": [
          "create",
          "destroy",
          "attach",
          "detach",
          "expose"
        ],
        "backend": "resource",
        "create": "[--runtime <name>] [--cpu <milli>] [--memory <bytes>] [--disk <bytes>]",
        "env": {
          "prefix": "FLYNN_MONGODB_",
          "conventional": "DATABASE_URL"
        },
        "runtimes": {
          "source": "catalog",
          "engine": "mongodb",
          "default": "small",
          "custom_sizing": true
        },
        "expose": {
          "protocol": "tcp",
          "tls_modes": [
            "off",
            "passthrough",
            "terminate"
          ],
          "default_tls": "passthrough",
          "hostname": "SERVICE.CLUSTERDOMAIN"
        },
        "instance_port": true,
        "reject": [
          {
            "flag": "--follow",
            "message": "mongodb has no followers; use flynn mongodb:scale <n> to change the node count"
          }
        ],
        "pass_app": true
      }
    },
    {
      "name": "kafka",
      "kind": "resource-provider",
      "repo": "flynn-plugin-kafka",
      "description": "Apache Kafka 3.9 (KRaft). Provision with flynn addons:create kafka.",
      "addon": {
