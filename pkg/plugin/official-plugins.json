          "attach",
          "detach",
          "expose"
        ],
        "backend": "resource",
        "create": "[--runtime <name>] [--cpu <milli>] [--memory <bytes>] [--disk <bytes>]",
        "env": {
          "prefix": "FLYNN_KAFKA_",
          "conventional": "KAFKA_URL"
        },
        "runtimes": {
          "source": "catalog",
          "engine": "kafka",
          "default": "small",
          "custom_sizing": true
        },
        "expose": {
          "protocol": "tcp",
          "tls_modes": [
            "off",
            "passthrough",
            "terminate"
          ],
          "default_tls": "passthrough",
          "hostname": "SERVICE.CLUSTERDOMAIN"
        },
        "instance_port": true,
        "reject": [
          {
            "flag": "--follow",
            "message": "kafka has no followers; use flynn kafka:scale <n> to change the node count"
          }
        ],
        "pass_app": true
      }
    },
    {
      "name": "clickhouse",
      "kind": "resource-provider",
      "repo": "flynn-plugin-clickhouse",
      "description": "ClickHouse analytics database. Provision with flynn addons:create clickhouse.",
      "addon": {
        "type": "clickhouse",
        "description": "Isolated ClickHouse instance",
        "verbs": [
          "create",
          "destroy",
          "attach",
          "detach",
          "expose"
        ],
        "backend": "resource",
        "create": "[--runtime <name>] [--cpu <milli>] [--memory <bytes>] [--disk <bytes>]",
        "env": {
