          "engine": "clickhouse",
          "default": "small",
          "custom_sizing": true
        },
        "expose": {
          "protocol": "tcp",
          "tls_modes": [
            "off",
            "passthrough",
            "terminate"
          ],
          "default_tls": "passthrough",
          "hostname": "SERVICE.CLUSTERDOMAIN"
        },
        "instance_port": true,
        "reject": [
          {
            "flag": "--follow",
            "message": "clickhouse has no followers; use flynn clickhouse:scale <n> to change the node count"
          }
        ],
        "pass_app": true
      }
    },
    {
      "name": "dashboard",
      "kind": "app",
      "repo": "flynn-plugin-dashboard",
      "description": "Cluster web dashboard for operators."
    },
    {
      "name": "www",
      "kind": "app",
      "repo": "flynn-plugin-www",
      "description": "Public cluster homepage on the apex and www hostnames."
    },
    {
      "name": "discovery",
      "kind": "app",
      "repo": "flynn-plugin-discovery",
      "description": "Public cluster discovery endpoint."
    },
    {
      "name": "otel",
      "aliases": [
        "opentelemetry"
      ],
      "kind": "app",
      "repo": "flynn-plugin-otel",
      "description": "Forward cluster metrics to an OpenTelemetry collector (OTLP/HTTP)."
    },
    {
      "name": "letsencrypt",
      "aliases": [
        "acme",
        "le"
      ],
      "kind": "app",
      "repo": "flynn-plugin-letsencrypt",
      "description": "Let's Encrypt / ACME certificates. Enable HTTPS with flynn letsencrypt:enable <hostname>."
    },
    {
      "name": "scheduler",
      "kind": "scheduler",
      "repo": "flynn-plugin-scheduler",
      "description": "Cron and interval jobs for apps. Manage with flynn scheduler.",
      "addon": {
        "type": "scheduler",
        "description": "Cron and interval jobs for an app",
        "verbs": [
          "create",
          "destroy"
        ],
        "backend": "plugin",
        "api": "http://scheduler.discoverd"
      }
    },
    {
      "name": "autoscale",
      "kind": "app",
      "repo": "flynn-plugin-autoscale",
      "description": "Scale web dynos when router HTTP response time p95 stays high. Manage with flynn autoscale."
    },
    {
      "name": "github",
      "kind": "app",
      "repo": "flynn-plugin-github",
      "description": "GitHub App deploys. Connect a repo with flynn github:connect after flynn-host plugin:install github."
    },
    {
      "name": "pipeline",
      "kind": "app",
      "repo": "flynn-plugin-pipeline",
      "description": "Environments and artifact promotion. Group apps with flynn pipeline after flynn-host plugin:install pipeline."
    },
    {
      "name": "enterprise",
      "kind": "app",
      "repo": "flynn-plugin-enterprise",
      "description": "SSO, audit, and granular RBAC. Unlock custom roles with flynn-host plugin:install enterprise."
    }
  ],
  "private_plugins": [
    {
      "name": "billing",
      "repo": "flynn-plugin-billing",
      "description": "Hosted Stripe billing, plans, dyno metering, and feature paywalls. Not installable with plugin:install billing; company-operated clusters only."
    }
  ],
  "plugin_groups": [
    {
      "name": "hosted",
      "plugins": [
        "dashboard",
        "enterprise",
        "billing"
      ],
      "tenancy_mode": "hosted"
    }
  ]
}
