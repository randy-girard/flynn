#!/bin/bash
#
# Helper script to build Go binaries with version ldflags
# Usage: go-build-version <version> [go build args...]
#
# Example: go-build-version v20260129.0 -o ./build/bin/flynn-host ./host
#
# Uses the real Go toolchain directly. The Flynn builder installs
# /usr/local/bin/go as a wrapper that forces CGO_ENABLED=0 and rewrites
# "go build" flags; routing through it breaks CGO binaries like flynn-host
# (runtime segfault) and can mangle -ldflags when combined with this script.

set -eo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: $0 <version> [go build args...]" >&2
  exit 1
fi

VERSION="$1"
shift

LDFLAGS="-X github.com/flynn/flynn/pkg/version.version=${VERSION}"

GO_BIN="${GOROOT:-/usr/local/go}/bin/go"
if ! [[ -x "${GO_BIN}" ]]; then
  GO_BIN="$(command -v go)"
fi

TAGS=()
# flynn-host needs CGO + seccomp; flynn-init and other tools set CGO_ENABLED=0.
if [[ "${CGO_ENABLED:-1}" == "1" ]]; then
  TAGS=(-tags "apparmor,seccomp")
fi

exec env CGO_ENABLED="${CGO_ENABLED:-1}" GOFLAGS="-mod=vendor" \
  "${GO_BIN}" build "${TAGS[@]}" -ldflags "${LDFLAGS}" "$@"
