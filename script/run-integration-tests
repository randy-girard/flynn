#!/bin/bash

set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "${ROOT}/script/lib/util.sh"

usage() {
  cat <<USAGE >&2
usage: $0 [options]

Boot a Flynn cluster and run integration tests.

OPTIONS:
  -h, --help               Show this message
  -n, --size=SIZE          Cluster size [default: 1]
  -f, --filter=FILTER      Regular expression selecting which tests and/or suites to run
  -s, --stream             Stream debug output
  -v, --version=VERSION    Boot using the released VERSION (e.g. v20151104.1)

Single-test example:
  $0 -f 'RouterSuite\\.TestAdditionalHttpPorts'

Or use script/run-single-integration-test.sh for the same effect.

ENVIRONMENT:
  CLUSTER_DOMAIN               DNS zone for controller routes [default: \${size}.localflynn.com]
  TEST_CLUSTER_HOST_TIMEOUT    Host boot timeout for nested clusters (e.g. 15m; TCG VMs are slow)
  HOST_MACHINE                 Machine hardware arch from uname -m [default: outer host; nested skips use this]
USAGE
}

main() {
  # Vagrant installs Go at /usr/local/go. sudo secure_path and non-interactive
  # login shells do not pick up /etc/profile.d/flynn-go.sh.
  if [[ -x /usr/local/go/bin/go ]]; then
    export PATH="/usr/local/go/bin:${PATH}"
  fi

  local size="1"
  local filter
  local stream=false
  local version=""

  while true; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -n | --size)
        if [[ -z "$2" ]]; then
          fail "--size flag requires an argument"
        fi
        size="$2"
        shift 2
        ;;
      -f | --filter)
        if [[ -z "$2" ]]; then
          fail "--filter flag requires an argument"
        fi
        filter="$2"
        shift 2
        ;;
      -s | --stream)
        stream=true
        shift
        ;;
      -v | --version)
        if [[ -z "$2" ]]; then
          fail "--version flag requires an argument"
        fi
        version="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ $# -ne 0 ]]; then
    usage
    exit 1
  fi

  # Slugbuilder runs on this machine. aarch64 hosts need qemu-user binfmt
  # before x86_64 Heroku buildpack binaries can exec.
  case "$(uname -m)" in
    aarch64 | arm64)
      echo "===> registering qemu-user binfmt for x86_64 buildpacks"
      "${ROOT}/script/vagrant/guest/ensure-qemu-binfmt.sh"
      ;;
  esac

  local flynn="${ROOT}/build/bin/flynn"
  local flynn_host="${ROOT}/build/bin/flynn-host"

  pushd "${ROOT}" >/dev/null
  FLYNN_BUILD_TEST_BINARIES=1 make
  popd >/dev/null

  local boot_flags=(
    "--size" "${size}"
  )
  if [[ -n "${version}" ]]; then
    boot_flags+=("--version" "${version}")
  fi
  export CLUSTER_DOMAIN="${CLUSTER_DOMAIN:-${size}.localflynn.com}"
  export FLYNN_ADMIN_EMAIL="${FLYNN_ADMIN_EMAIL:-admin@${CLUSTER_DOMAIN}}"
  export FLYNN_ADMIN_PASSWORD="${FLYNN_ADMIN_PASSWORD:-flynn-dev}"
  local bootstrap_log
  bootstrap_log="$(mktemp)"
  set +e
  "${ROOT}/script/bootstrap-flynn" "${boot_flags[@]}" >"${bootstrap_log}" 2>&1
  local boot_st=$?
  set -e
  cat "${bootstrap_log}" >&2
  if [[ "${boot_st}" -ne 0 ]]; then
    rm -f "${bootstrap_log}"
    echo Bootstrap failed >&2
    exit 1
  fi
  # Admin creation prints after the manifest, so the cluster add line is not
  # the last line. Accept the colon form and the older space form.
  local cluster_add
  cluster_add="$(grep -E '^flynn cluster(:add| add) ' "${bootstrap_log}" | tail -1 || true)"
  rm -f "${bootstrap_log}"
  if [[ -z "${cluster_add}" ]]; then
    echo "could not find flynn cluster add command after bootstrap" >&2
    exit 1
  fi
  # Older bootstrap lines ended with the controller key. cluster:add does
  # not take that key, and current cli-add-command omits it entirely.
  local word_count controller_key=""
  word_count=$(wc -w <<<"${cluster_add}")
  if [[ "${word_count}" -ge 7 ]]; then
    controller_key="${cluster_add##* }"
    cluster_add="${cluster_add% *}"
  fi
  local cluster_add_args="${cluster_add#flynn cluster:add }"
  cluster_add_args="${cluster_add_args#flynn cluster add }"

  # discoverd is bound to TEST-NET IPs (see script/bootstrap-flynn), not loopback.
  local ips=()
  local index
  for index in $(seq 0 $((size - 1))); do
    ips+=("192.0.2.20$((${index}))")
  done
  local discoverd_csv
  discoverd_csv="$(join "," ${ips[@]/%/:1111})"
  # flynn-host run → pkg/exec creates cluster.NewClient() on this machine using DISCOVERD
  # from the environment (defaults to 127.0.0.1:1111 if unset). Passing DISCOVERD only
  # via /usr/bin/env configures the test container, not the CLI parent process.
  export DISCOVERD="${discoverd_csv}"

  # Sirenia /status reads CONTROLLER_KEY from the test process. The key
  # lives on the running controller job (discoverd no longer publishes it).
  if [[ -z "${controller_key}" ]]; then
    local controller_job
    controller_job="$(
      "${flynn_host}" ps -q -f '{{if and (eq (metadata "flynn-controller.app_name") "controller") (eq (metadata "flynn-controller.type") "web")}}{{.Job.ID}}{{end}}' \
        | awk 'NF { print; exit }'
    )"
    if [[ -n "${controller_job}" ]]; then
      controller_key="$(
        "${flynn_host}" inspect "${controller_job}" \
          | awk -F '\t' '{
              gsub(/^[ \t]+|[ \t]+$/, "", $1)
              gsub(/^[ \t]+|[ \t]+$/, "", $2)
              if ($1 == "ENV[CONTROLLER_KEY]") key = $2
              if ($1 == "ENV[AUTH_KEY]" && key == "") key = $2
            } END { print key }'
      )"
    fi
  fi
  if [[ -z "${controller_key}" ]]; then
    echo "controller AUTH_KEY was not found on the running controller job" >&2
    exit 1
  fi

  local cluster_domain="${CLUSTER_DOMAIN}"
  local host_machine="${HOST_MACHINE:-$(uname -m)}"

  # flynn-test uses Go's flag package; each flag and value must be a separate argv element.
  local flynn_test_args=(
    "--concurrency" "1"
    "--debug"
    "--router-ip" "${ips[0]}"
  )

  local mounts=(
    "${ROOT}:/go/src/github.com/flynn/flynn"
    "/var/run/docker.sock:/var/run/docker.sock"
    "/var/lib/flynn:/var/lib/flynn"
  )
  # The test image's docker client is whatever ./build.sh test last baked.
  # Bind the host client and buildx plugin so docker build talks to the
  # daemon on this machine, including arm64 hosts.
  if [[ -x /usr/bin/docker ]]; then
    mounts+=("/usr/bin/docker:/usr/local/bin/docker")
  fi
  local plugin_dir=""
  for plugin_dir in /usr/libexec/docker/cli-plugins /usr/lib/docker/cli-plugins; do
    if [[ -d "${plugin_dir}" ]]; then
      mounts+=("${plugin_dir}:/usr/libexec/docker/cli-plugins")
      break
    fi
    plugin_dir=""
  done

  if [[ -d "${ROOT}/backups" ]]; then
    flynn_test_args+=("--backups-dir" "${ROOT}/backups")
    mounts+=("${ROOT}/backups:${ROOT}/backups")
  fi
  if [[ -n "${filter}" ]]; then
    flynn_test_args+=("--run" "${filter}")
  fi
  # Cluster-test images are not part of the production image build. discoverd
  # for flynn-builder is the cluster this script just bootstrapped.
  # test/apps is compiled into the test-apps image, so a source change has
  # to rebuild that image or the suite keeps running the previous binaries.
  local test_image="${ROOT}/build/image/test.json"
  local test_apps_image="${ROOT}/build/image/test-apps.json"
  local need_test_images=false
  if [[ ! -s "${test_image}" || ! -s "${test_apps_image}" ]]; then
    need_test_images=true
  elif find "${ROOT}/test/apps" \( -name '*.go' -o -name '*.sh' \) -newer "${test_apps_image}" 2>/dev/null | grep -q .; then
    echo "===> test/apps is newer than ${test_apps_image}"
    need_test_images=true
  fi
  if $need_test_images; then
    echo "===> building cluster-test images"
    "${ROOT}/build.sh" test
  fi
  if $stream; then
    flynn_test_args+=("--stream")
  fi
  if [[ -t 0 ]]; then
    flynn_test_args+=("--interactive")
  fi

  "${flynn_host}" run \
    --bind "$(join "," ${mounts[@]})" \
    --volume "/tmp" \
    "${ROOT}/build/image/test.json" \
    /usr/bin/env \
    ROOT="/go/src/github.com/flynn/flynn" \
    DISCOVERD="${discoverd_csv}" \
    ROUTER_IP="${ips[0]}" \
    DOMAIN="${cluster_domain}" \
    HOST_MACHINE="${host_machine}" \
    CLUSTER_ADD_ARGS="${cluster_add_args}" \
    FLYNN_EMAIL="${FLYNN_ADMIN_EMAIL}" \
    FLYNN_PASSWORD="${FLYNN_ADMIN_PASSWORD}" \
    CONTROLLER_KEY="${controller_key}" \
    USE_KVM="$([[ -e /dev/kvm ]] && echo true)" \
    /bin/bash "/go/src/github.com/flynn/flynn/test/run.sh" \
    "${flynn_test_args[@]}"
}

main $@
