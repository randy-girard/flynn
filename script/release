#!/bin/bash
#
# Create a Flynn Release
#
# This script should be run AFTER building Flynn with script/build-flynn.
# It packages the built binaries and creates either a GitHub release or a
# local tarball for testing.
#
# Usage:
#   ./script/release                                    # Create tarball (default)
#   ./script/release --target tarball                   # Create tarball for testing
#   ./script/release --target github                    # Create GitHub release
#   ./script/release --version v20240127.0              # Specific version
#   ./script/release --dry-run                          # Show what would be packaged
#   ./script/release --output /path/to/output           # Custom output directory
#
# Prerequisites:
#   - Flynn must be built (run script/build-flynn first)
#   - For GitHub releases: GitHub CLI (gh) must be installed and authenticated
#   - Changes should be committed (for accurate release notes)
#

set -eo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "${ROOT}/script/lib/ui.sh"

# Defaults
VERSION=""
TARGET="tarball"  # Default to tarball for safe testing
GITHUB_REPO="${FLYNN_GITHUB_REPO:-randy-girard/flynn}"
DRY_RUN=false
DRAFT=false
PRERELEASE=false
OUTPUT_SET=false
BUILD_DIR="${ROOT}/build/bin"
OUTPUT_DIR=""

usage() {
  cat <<USAGE >&2
usage: $0 [OPTIONS]

Create a Flynn Release (tarball or GitHub).

OPTIONS:
  -h, --help                  Show this message
  --target TARGET             Release target: 'tarball', 'package', 'github', or 'notes' [default: tarball]
  --version VERSION           Version for release (e.g., v20240127.0)
  --output DIR                Output directory for tarball/package [default: ./build/release]
                              For --target notes, a file path to write the GitHub body
  --github-repo OWNER/REPO    GitHub repository [default: randy-girard/flynn]
  --draft                     Create the GitHub release as a draft (github target only)
  --prerelease                Mark the GitHub release as a prerelease (github target only)
  --dry-run                   Show what would be packaged without creating release

TARGETS:
  tarball   Create a compressed tarball for manual testing/deployment
            Output: flynn-<version>.tar.gz with install script
  package   Write individual GitHub Release assets into --output (no upload, no mega-tarball)
  github    Create a GitHub release with all artifacts uploaded
  notes     Print (or --output) the grouped GitHub release body; no binaries needed

EXAMPLES:
  # Build and create a tarball for testing
  ./script/build-flynn
  ./script/release --target tarball --version v20240210.0

  # Upload tarball to server and install
  scp build/release/flynn-v20240210.0.tar.gz root@server:/tmp/
  ssh root@server 'cd /tmp && tar xzf flynn-v20240210.0.tar.gz && ./install-flynn'

  # Package individual assets for CI / GitHub Releases (each asset must be < 2GiB)
  ./script/release --target package --version v20240210.0

  # After testing, create GitHub release
  ./script/release --target github --version v20240210.0

  # Preview grouped GitHub release notes (no build required)
  ./script/release --target notes --version v20240210.0
USAGE
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --target)
      TARGET="$2"
      if [[ "${TARGET}" != "tarball" && "${TARGET}" != "package" && "${TARGET}" != "github" && "${TARGET}" != "notes" ]]; then
        fail "Invalid target: ${TARGET}. Must be 'tarball', 'package', 'github', or 'notes'"
      fi
      shift 2
      ;;
    --version)
      VERSION="$2"
      shift 2
      ;;
    --output)
      OUTPUT_DIR="$2"
      OUTPUT_SET=true
      shift 2
      ;;
    --github-repo)
      GITHUB_REPO="$2"
      shift 2
      ;;
    --draft)
      DRAFT=true
      shift
      ;;
    --prerelease)
      PRERELEASE=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

# Set default output directory
if [[ -z "${OUTPUT_DIR}" ]]; then
  OUTPUT_DIR="${ROOT}/build/release"
fi
# Always use an absolute path so tarball creation works after cd elsewhere.
# --target notes with no --output prints to stdout; skip rewriting.
if [[ "${TARGET}" != "notes" ]] || $OUTPUT_SET; then
  OUTPUT_DIR="$(cd "$(dirname "${OUTPUT_DIR}")" && pwd)/$(basename "${OUTPUT_DIR}")"
fi

# Get version from flynn-host if not provided
if [[ -z "${VERSION}" ]]; then
  FLYNN_HOST="${BUILD_DIR}/flynn-host"
  if [[ -x "${FLYNN_HOST}" ]]; then
    VERSION=$("${FLYNN_HOST}" version 2>/dev/null | head -n1)
    # Strip any commit suffix (e.g., v20260129.0-abc1234 -> v20260129.0)
    VERSION="${VERSION%%-*}"
    if [[ -n "${VERSION}" && "${VERSION}" != "dev" ]]; then
      info "Using version from flynn-host: ${VERSION}"
    else
      VERSION=""
    fi
  fi
fi

# Fall back to auto-generating version if still not set
if [[ -z "${VERSION}" ]]; then
  DATE_PREFIX="v$(date +%Y%m%d)"
  LATEST_TODAY=$(git tag -l "${DATE_PREFIX}.*" 2>/dev/null | sort -V | tail -n1)
  if [[ -n "${LATEST_TODAY}" ]]; then
    ITERATION="${LATEST_TODAY##*.}"
    VERSION="${DATE_PREFIX}.$((ITERATION + 1))"
  else
    VERSION="${DATE_PREFIX}.0"
  fi
  info "Auto-generated version: ${VERSION}"
fi

# shellcheck source=script/lib/release-notes.sh
source "${ROOT}/script/lib/release-notes.sh"
# shellcheck source=script/lib/github-release-upload.sh
source "${ROOT}/script/lib/github-release-upload.sh"
# shellcheck source=script/lib/release-layers.sh
source "${ROOT}/script/lib/release-layers.sh"

if [[ "${TARGET}" == "notes" ]]; then
  if $OUTPUT_SET; then
    flynn_github_release_notes "${VERSION}" "${GITHUB_REPO}" > "${OUTPUT_DIR}"
    info "Wrote GitHub release notes to ${OUTPUT_DIR}"
  else
    flynn_github_release_notes "${VERSION}" "${GITHUB_REPO}"
  fi
  exit 0
fi

# Verify build artifacts exist
if [[ ! -d "${BUILD_DIR}" ]]; then
  fail "Build directory not found: ${BUILD_DIR}\nRun 'script/build-flynn --version ${VERSION}' first!"
fi

if [[ ! -f "${BUILD_DIR}/flynn-host" ]]; then
  fail "flynn-host binary not found in ${BUILD_DIR}\nRun 'script/build-flynn --version ${VERSION}' first!"
fi

# Create release artifacts directory
RELEASE_DIR="/tmp/flynn-release-${VERSION}"
rm -rf "${RELEASE_DIR}"
mkdir -p "${RELEASE_DIR}"

info "Creating Flynn ${VERSION} release (target: ${TARGET})"

# Package binaries
package_binaries() {
  info "Packaging binaries..."

  # CLI binaries (already have OS/arch in name)
  CLI_BINARIES=(
    "flynn-linux-amd64"
    "flynn-linux-arm64"
    "flynn-darwin-amd64"
    "flynn-darwin-arm64"
    "flynn-windows-amd64.exe"
  )

  for bin in "${CLI_BINARIES[@]}"; do
    if [[ -f "${BUILD_DIR}/${bin}" ]]; then
      gzip -c "${BUILD_DIR}/${bin}" > "${RELEASE_DIR}/${bin}.gz"
      echo "  - ${bin}.gz"
    fi
  done

  # Host binaries - rename to include OS/arch for update command compatibility
  HOST_ARCH="$(go env GOARCH 2>/dev/null || true)"
  if [[ -z "${HOST_ARCH}" ]]; then
    case "$(uname -m)" in
      aarch64|arm64) HOST_ARCH=arm64 ;;
      x86_64|amd64) HOST_ARCH=amd64 ;;
      *) HOST_ARCH=amd64 ;;
    esac
  fi

  if [[ -f "${BUILD_DIR}/flynn-host" ]]; then
    gzip -c "${BUILD_DIR}/flynn-host" > "${RELEASE_DIR}/flynn-host-linux-${HOST_ARCH}.gz"
    echo "  - flynn-host-linux-${HOST_ARCH}.gz"
  fi

  if [[ -f "${BUILD_DIR}/flynn-init" ]]; then
    gzip -c "${BUILD_DIR}/flynn-init" > "${RELEASE_DIR}/flynn-init-linux-${HOST_ARCH}.gz"
    echo "  - flynn-init-linux-${HOST_ARCH}.gz"
  fi
}

# Package manifests
package_manifests() {
  info "Packaging manifests..."

  # images.json - prefer build/manifests/images.json
  if [[ -f "${ROOT}/build/manifests/images.json" ]]; then
    gzip -c "${ROOT}/build/manifests/images.json" > "${RELEASE_DIR}/images.json.gz"
    echo "  - images.json.gz (from build/manifests/images.json)"
  elif [[ -f "${ROOT}/build/images.json" ]]; then
    gzip -c "${ROOT}/build/images.json" > "${RELEASE_DIR}/images.json.gz"
    echo "  - images.json.gz (from build/images.json)"
  else
    fail "images.json is required to package a Flynn release (looked in build/manifests/images.json and build/images.json)"
  fi

  # bootstrap-manifest.json
  if [[ -f "${ROOT}/build/manifests/bootstrap-manifest.json" ]]; then
    gzip -c "${ROOT}/build/manifests/bootstrap-manifest.json" > "${RELEASE_DIR}/bootstrap-manifest.json.gz"
    echo "  - bootstrap-manifest.json.gz"
  else
    echo "  (no bootstrap-manifest.json found)"
  fi
}

# Package image manifests
package_image_manifests() {
  info "Packaging image manifests..."
  IMAGE_DIR="${ROOT}/build/image"
  if [[ -d "${IMAGE_DIR}" ]] && [[ -n "$(ls -A ${IMAGE_DIR}/*.json 2>/dev/null)" ]]; then
    mkdir -p "${RELEASE_DIR}/images"
    cp "${IMAGE_DIR}/"*.json "${RELEASE_DIR}/images/" 2>/dev/null || true
    (cd "${RELEASE_DIR}" && tar czf "images.tar.gz" images/)
    echo "  - images.tar.gz ($(ls ${RELEASE_DIR}/images/*.json 2>/dev/null | wc -l) manifests)"
    rm -rf "${RELEASE_DIR}/images"
  else
    echo "  (no image manifests found in ${IMAGE_DIR})"
  fi
}

# Package squashfs layers referenced by images.json. Copying the whole
# layer-cache would still miss blobs the builder treated as cached from JSON
# alone; copying only listed IDs and failing on a missing squashfs keeps
# images.json and GitHub assets in lockstep.
package_layers() {
  info "Packaging layers..."
  local json=""
  if [[ -f "${ROOT}/build/manifests/images.json" ]]; then
    json="${ROOT}/build/manifests/images.json"
  elif [[ -f "${ROOT}/build/images.json" ]]; then
    json="${ROOT}/build/images.json"
  else
    fail "images.json is required to package layers"
  fi

  local LAYER_CACHE="/var/lib/flynn/layer-cache"
  local ids id src LAYER_COUNT=0
  ids="$(flynn_images_json_layer_ids "${json}")" || fail "could not read layer ids from ${json}"

  echo "  package_layers copies only images.json layer blobs"
  local missing=0
  while IFS= read -r id; do
    [[ -z "${id}" ]] && continue
    src="${LAYER_CACHE}/${id}.squashfs"
    if [[ ! -f "${src}" ]]; then
      echo "ERROR: images.json layer ${id} has no squashfs at ${src}" >&2
      missing=1
      continue
    fi
    cp "${src}" "${RELEASE_DIR}/${id}.squashfs"
    if [[ -f "${LAYER_CACHE}/${id}.json" ]]; then
      cp "${LAYER_CACHE}/${id}.json" "${RELEASE_DIR}/${id}.json"
    fi
    LAYER_COUNT=$((LAYER_COUNT + 1))
  done <<< "${ids}"
  if [[ "${missing}" -ne 0 ]]; then
    fail "refusing to ship images.json with unpackaged layers"
  fi

  echo "  - ${LAYER_COUNT} layer squashfs files from images.json"
  flynn_verify_images_json_layers "${json}" "${RELEASE_DIR}" || fail "images.json layers missing from package dir"
}

# Generate checksums
generate_checksums() {
  info "Generating checksums..."
  (cd "${RELEASE_DIR}" && find . -type f \( -name "*.gz" -o -name "*.squashfs" -o -name "*.json" -o -name "install-flynn-*" \) | xargs sha512sum > checksums.sha512 2>/dev/null || true)
}

# Generate release notes from git commits (grouped by conventional type).
generate_release_notes() {
  info "Generating release notes from commits..."
  git fetch origin --tags --force 2>/dev/null || true

  PREVIOUS_TAG="$(flynn_previous_release_tag "${VERSION}")"
  local range
  range="$(flynn_commit_range_since_previous "${VERSION}")"
  if [[ -n "${PREVIOUS_TAG}" ]]; then
    echo "  Previous release: ${PREVIOUS_TAG}"
    echo "  Found $(git rev-list --count "${range}" 2>/dev/null || echo 0) commits since ${PREVIOUS_TAG}"
  else
    echo "  No previous tag found, using recent commits"
  fi
  RELEASE_NOTES="$(flynn_categorized_release_notes "${range}")"
}



# Create install-flynn script from template
# Args: $1 = install source ("tarball" or "github")
create_install_script() {
  local install_source="$1"
  info "Creating install-flynn script (source: ${install_source})..."

  # Copy template and replace placeholders
  # Use | as delimiter since GITHUB_REPO contains /
  sed -e "s|__INSTALL_SOURCE__|${install_source}|g" \
      -e "s|__FLYNN_VERSION__|${VERSION}|g" \
      -e "s|__GITHUB_REPO__|${GITHUB_REPO}|g" \
      "${ROOT}/script/install-flynn-release" > "${RELEASE_DIR}/install-flynn"

  chmod +x "${RELEASE_DIR}/install-flynn"
  echo "  - install-flynn"
}

# Package the individual assets used by GitHub Releases / install-flynn-release
# (binaries, manifests, layers, install scripts, checksums). No mega-tarball.
package_github_assets() {
  package_binaries
  package_manifests
  package_image_manifests
  package_layers
  create_install_script "github"

  info "Copying CLI installer..."
  sed "s/__FLYNN_VERSION__/${VERSION}/g" "${ROOT}/script/install-flynn-cli" > "${RELEASE_DIR}/install-flynn-cli"
  chmod +x "${RELEASE_DIR}/install-flynn-cli"
  echo "  - install-flynn-cli"

  generate_checksums
}

# Warn if any staged asset would exceed GitHub's 2GiB release asset limit.
check_github_asset_sizes() {
  local dir="$1"
  local limit=2147483648
  local bad=0
  local f size
  while IFS= read -r -d '' f; do
    size=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f")
    if [[ "${size}" -ge "${limit}" ]]; then
      echo "ERROR: $(basename "$f") is ${size} bytes (>= 2GiB GitHub release asset limit)" >&2
      bad=1
    fi
  done < <(find "${dir}" -type f -print0)
  if [[ "${bad}" -ne 0 ]]; then
    fail "one or more release assets exceed GitHub's 2GiB limit"
  fi
}

# Write individual GitHub-style assets into OUTPUT_DIR (for CI artifact handoff).
create_package() {
  info "Packaging individual release assets into ${OUTPUT_DIR}..."

  package_github_assets

  info "Release artifacts:"
  ls -lah "${RELEASE_DIR}"

  check_github_asset_sizes "${RELEASE_DIR}"

  mkdir -p "${OUTPUT_DIR}"
  # Replace prior package contents so CI uploads only this version's assets.
  find "${OUTPUT_DIR}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  cp -a "${RELEASE_DIR}/." "${OUTPUT_DIR}/"

  info "Packaged $(find "${OUTPUT_DIR}" -type f | wc -l) files into ${OUTPUT_DIR} ($(du -sh "${OUTPUT_DIR}" | awk '{print $1}'))"
  echo ""
  echo "Upload these files as individual GitHub Release assets (not a single mega-tarball)."
  echo "Create the release with:"
  echo "  ./script/release --target github --version ${VERSION}"
  echo "or from CI: gh release create ${VERSION} ${OUTPUT_DIR}/*"
}

# Create tarball for local testing
create_tarball() {
  info "Creating tarball for local testing..."

  package_binaries
  package_manifests
  package_image_manifests
  package_layers
  create_install_script "tarball"
  generate_checksums

  # Create output directory
  mkdir -p "${OUTPUT_DIR}"

  # Create the tarball with files in a versioned folder
  TARBALL_NAME="flynn-${VERSION}.tar.gz"
  FOLDER_NAME="flynn-${VERSION}"
  info "Creating ${TARBALL_NAME} (contents in ${FOLDER_NAME}/)..."

  # Rename the release directory to the versioned folder name, create tarball, then rename back
  RELEASE_PARENT="$(dirname "${RELEASE_DIR}")"
  mv "${RELEASE_DIR}" "${RELEASE_PARENT}/${FOLDER_NAME}"
  (cd "${RELEASE_PARENT}" && tar czf "${OUTPUT_DIR}/${TARBALL_NAME}" "${FOLDER_NAME}")
  mv "${RELEASE_PARENT}/${FOLDER_NAME}" "${RELEASE_DIR}"

  info "Release artifacts:"
  ls -lah "${RELEASE_DIR}"

  info "Tarball created: ${OUTPUT_DIR}/${TARBALL_NAME}"
  echo ""
  echo "To install on a server:"
  echo "  1. Upload the tarball:  scp ${OUTPUT_DIR}/${TARBALL_NAME} root@server:/tmp/"
  echo "  2. Extract and install: ssh root@server 'cd /tmp && tar xzf ${TARBALL_NAME} && cd ${FOLDER_NAME} && ./install-flynn'"
  echo "  3. Or install from the tarball without extracting first (GitHub or tarball install script):"
  echo "       sudo bash install-flynn --tarball /tmp/${TARBALL_NAME}"
  echo ""
  echo "Note: GitHub Releases reject assets >= 2GiB. Prefer --target package/github for publishing."
  echo "After testing, create GitHub release with:"
  echo "  ./script/release --target github --version ${VERSION}"
}

# Create GitHub release
create_github_release() {
  # Check for GitHub CLI
  if ! command -v gh &> /dev/null; then
    fail "GitHub CLI (gh) is not installed. Install it with: apt install gh"
  fi

  # Check if authenticated
  if ! gh auth status &> /dev/null; then
    fail "Not authenticated with GitHub. Run: gh auth login"
  fi

  info "Creating GitHub Release ${VERSION} for ${GITHUB_REPO}..."

  package_github_assets
  generate_release_notes

  info "Release artifacts:"
  ls -lah "${RELEASE_DIR}"

  check_github_asset_sizes "${RELEASE_DIR}"

  info "Pushing to GitHub Release ${VERSION}..."
  NOTES_FILE="$(mktemp)"
  flynn_github_release_notes "${VERSION}" "${GITHUB_REPO}" > "${NOTES_FILE}"

  local draft_flag=false prerelease_flag=false
  if $DRAFT; then
    draft_flag=true
  fi
  if $PRERELEASE; then
    prerelease_flag=true
  fi
  github_release_publish \
    --version "${VERSION}" \
    --repo "${GITHUB_REPO}" \
    --title "Flynn ${VERSION}" \
    --notes-file "${NOTES_FILE}" \
    --dir "${RELEASE_DIR}" \
    --draft "${draft_flag}" \
    --prerelease "${prerelease_flag}"

  rm -f "${NOTES_FILE}"

  info "GitHub Release ${VERSION} created successfully!"
  echo "     https://github.com/${GITHUB_REPO}/releases/tag/${VERSION}"
}

# Dry run - show what would be packaged
do_dry_run() {
  info "DRY RUN - Would create ${TARGET} release ${VERSION}..."

  if [[ "${TARGET}" == "package" || "${TARGET}" == "github" ]]; then
    package_github_assets
  else
    package_binaries
    package_manifests
    package_image_manifests
    package_layers
    create_install_script "tarball"
    generate_checksums
  fi

  if [[ "${TARGET}" == "github" ]]; then
    generate_release_notes
    echo ""
    echo "Release notes:"
    echo "---"
    echo "${RELEASE_NOTES}"
    echo "---"
  fi

  echo ""
  info "Release artifacts that would be created:"
  ls -lah "${RELEASE_DIR}"

  if [[ "${TARGET}" == "tarball" ]]; then
    echo ""
    echo "Would create: ${OUTPUT_DIR}/flynn-${VERSION}.tar.gz"
  elif [[ "${TARGET}" == "package" ]]; then
    echo ""
    echo "Would write individual assets to: ${OUTPUT_DIR}/"
  else
    echo ""
    echo "Would upload to: https://github.com/${GITHUB_REPO}/releases/tag/${VERSION}"
  fi
}

# Main execution
if $DRY_RUN; then
  do_dry_run
else
  case "${TARGET}" in
    tarball)
      create_tarball
      ;;
    package)
      create_package
      ;;
    github)
      create_github_release
      ;;
    *)
      fail "Invalid target: ${TARGET}"
      ;;
  esac
fi

# Cleanup
rm -rf "${RELEASE_DIR}"