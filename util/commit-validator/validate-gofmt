#!/bin/bash

source "$(dirname "${BASH_SOURCE}")/.validate"

IFS=$'\n'
files=( $(validate_diff --diff-filter=ACMR --name-only -- '*.go' \
          | grep -v '^vendor/' || true) )
unset IFS

# Uncommitted and untracked Go files (deletions are skipped below).
while IFS= read -r file; do
  [ -z "${file}" ] && continue
  case "${file}" in
    vendor/*) continue ;;
  esac
  files+=( "${file}" )
done < <(git diff --name-only -- '*.go'; git diff --cached --name-only -- '*.go'; git ls-files --others --exclude-standard -- '*.go')

# Dedupe (bash 3.2 — no associative arrays on macOS /bin/bash).
unique=()
for file in "${files[@]}"; do
  [ -z "${file}" ] && continue
  already=0
  for existing in "${unique[@]}"; do
    if [ "${existing}" = "${file}" ]; then
      already=1
      break
    fi
  done
  [ "${already}" -eq 1 ] && continue
  unique+=( "${file}" )
done
files=( "${unique[@]}" )

badFiles=()
for file in "${files[@]}"; do
  # Deleted paths have nothing to format. Check the tree that will be
  # committed / tested (working copy on CI is the commit).
  if [ ! -f "${file}" ]; then
    continue
  fi
  if [ "$(gofmt -s -l "${file}")" ]; then
    badFiles+=( "${file}" )
  fi
done

if [ ${#badFiles[@]} -eq 0 ]; then
  echo 'All Go source files are properly formatted.'
else
  {
    echo "These files are not properly gofmt'd:"
    for file in "${badFiles[@]}"; do
      echo " - ${file}"
    done
    echo
    echo 'Please reformat the above files using "gofmt -s -w" and commit the result.'
    echo
  } >&2
  false
fi
