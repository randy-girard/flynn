#!/bin/bash

source "$(dirname "${BASH_SOURCE}")/.validate"

IFS=$'\n'
files=( $(validate_diff --diff-filter=ACMR --name-only -- '*.go' \
          | grep -v '^vendor/' || true) )
unset IFS

# Uncommitted Go files: catch gofmt drift before it is committed (CI checks
# committed content via git show below).
while IFS= read -r file; do
  [ -z "${file}" ] && continue
  case "${file}" in
    vendor/*) continue ;;
  esac
  files+=( "${file}" )
done < <(git diff --name-only -- '*.go'; git diff --cached --name-only -- '*.go')

# Dedupe (bash 3.2 — no associative arrays on macOS /bin/bash).
unique=()
for file in "${files[@]}"; do
  [ -z "${file}" ] && continue
  already=0
  for existing in "${unique[@]}"; do
    if [ "${existing}" = "${file}" ]; then
      already=1
      break
    fi
  done
  [ "${already}" -eq 1 ] && continue
  unique+=( "${file}" )
done
files=( "${unique[@]}" )

badFiles=()
for file in "${files[@]}"; do
  # Committed content must match gofmt -s (what GitHub Actions checks).
  if git cat-file -e "${VALIDATE_HEAD}:${file}" 2>/dev/null; then
    if [ "$(git show "${VALIDATE_HEAD}:${file}" | gofmt -s -l)" ]; then
      badFiles+=( "${file}" )
      continue
    fi
  fi
  # Working tree must also be formatted.
  if [ -f "${file}" ] && [ "$(gofmt -s -l "${file}")" ]; then
    badFiles+=( "${file}" )
  fi
done

if [ ${#badFiles[@]} -eq 0 ]; then
  echo 'All Go source files are properly formatted.'
else
  {
    echo "These files are not properly gofmt'd:"
    for file in "${badFiles[@]}"; do
      echo " - ${file}"
    done
    echo
    echo 'Please reformat the above files using "gofmt -s -w" and commit the result.'
    echo
  } >&2
  false
fi
